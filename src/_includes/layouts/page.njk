---
layout: layouts/base.njk
---
<article class="page">
  <header class="page-head">
    <p class="kicker">{{ kicker or "FiscalHour" }}</p>
    <h1>{{ title }}</h1>
  </header>
  <div class="prose">
    {{ content | safe }}
  </div>
  {% if legal %}
  {% include "partials/legal-notice.njk" %}
  {% endif %}
</article>
