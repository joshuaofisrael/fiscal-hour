<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<script>
window.dataLayer = window.dataLayer || [];
function gtag(){dataLayer.push(arguments);}
gtag('consent', 'default', {
  'ad_storage': 'denied',
  'ad_user_data': 'denied',
  'ad_personalization': 'denied',
  'analytics_storage': 'denied'
});
</script>
{% set fullTitle = seoTitle or (title | pageTitle) %}
<title>{{ fullTitle }}</title>
{% set metaSource = seoDescription or description or summary %}
<meta name="description" content="{{ metaSource | metaDescription }}">
<meta name="color-scheme" content="light">
<meta name="theme-color" content="#0E1A2B">
<meta name="referrer" content="strict-origin-when-cross-origin">
<meta http-equiv="Content-Security-Policy" content="default-src 'self'; img-src 'self' data: https://www.google-analytics.com https://www.googletagmanager.com; style-src 'self'; font-src 'self'; script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com https://pagead2.googlesyndication.com https://www.googletagmanager.com; connect-src 'self' https://cloudflareinsights.com https://www.google-analytics.com https://*.google-analytics.com https://analytics.google.com https://*.analytics.google.com https://www.googletagmanager.com; object-src 'none'; base-uri 'self'; form-action {% if formAction %}{{ formAction }}{% else %}'none'{% endif %}; frame-ancestors 'none'">
{% if site.adsensePublisher %}
<script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client={{ site.adsenseClient }}" crossorigin="anonymous"></script>
<meta name="google-adsense-account" content="{{ site.adsenseClient }}">
{% endif %}
{% if draft or noindex %}
<meta name="robots" content="noindex, nofollow">
{% elif robots %}
<meta name="robots" content="{{ robots }}">
{% else %}
<meta name="robots" content="index, follow">
{% endif %}
<link rel="canonical" href="{{ page.url | absoluteUrl }}">
<link rel="icon" href="{{ '/assets/favicon.svg' | url }}" type="image/svg+xml">
<link rel="icon" href="{{ '/assets/logo.png' | url }}" type="image/png" sizes="192x192">
<link rel="apple-touch-icon" href="{{ '/assets/logo.png' | url }}">
<link rel="stylesheet" href="{{ '/assets/css/site.css' | url }}">
<link rel="alternate" type="application/rss+xml" title="{{ site.name }} RSS" href="{{ '/feed.xml' | url }}">
<link rel="alternate" type="application/atom+xml" title="{{ site.name }} Atom" href="{{ '/atom.xml' | url }}">
<meta property="og:site_name" content="{{ site.name }}">
<meta property="og:locale" content="{{ site.locale }}">
<meta property="og:title" content="{{ fullTitle }}">
<meta property="og:description" content="{{ metaSource | metaDescription }}">
<meta property="og:url" content="{{ page.url | absoluteUrl }}">
{% if kind == "article" and not draft %}
<meta property="og:type" content="article">
<meta property="article:published_time" content="{{ page.date | isoDate }}">
<meta property="article:modified_time" content="{{ (updatedAt or page.date) | isoDate }}">
<meta property="article:section" content="{{ category }}">
{% else %}
<meta property="og:type" content="website">
{% endif %}
<meta property="og:image" content="{{ '/assets/logo.png' | absoluteUrl }}">
<meta property="og:image:alt" content="Copper FH monogram on a navy square, the FiscalHour mark.">
<meta property="og:image:width" content="192">
<meta property="og:image:height" content="192">
<meta name="twitter:card" content="summary">
<meta name="twitter:title" content="{{ fullTitle }}">
<meta name="twitter:description" content="{{ metaSource | metaDescription }}">
<meta name="twitter:image" content="{{ '/assets/logo.png' | absoluteUrl }}">
<meta name="twitter:image:alt" content="Copper FH monogram on a navy square, the FiscalHour mark.">
{% structuredData %}
