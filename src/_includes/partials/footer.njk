<footer class="site-footer">
  <div class="wrap footer-note">
    <p><a href="{{ '/disclaimer/' | url }}">News only, not investment advice.</a></p>
  </div>
  <div class="wrap footer-grid">
    <nav aria-label="Coverage">
      <h2>Coverage</h2>
      <ul>
        {% for item in site.categories %}
        <li><a href="{{ ('/category/' ~ item.slug ~ '/') | url }}">{{ item.name }}</a></li>
        {% endfor %}
        <li><a href="{{ '/archive/' | url }}">Archive</a></li>
      </ul>
    </nav>
    <nav aria-label="Company links">
      <h2>Company</h2>
      <ul>
        <li><a href="{{ '/about/' | url }}">About</a></li>
        <li><a href="{{ '/contact/' | url }}">Contact Us</a></li>
        <li><a href="{{ '/sources-ethics/' | url }}">Sources &amp; Ethics</a></li>
        <li><a href="{{ '/corrections/' | url }}">Corrections</a></li>
      </ul>
    </nav>
    <nav aria-label="Legal and feeds">
      <h2>Legal and feeds</h2>
      <ul>
        <li><a href="{{ '/terms/' | url }}">Terms</a></li>
        <li><a href="{{ '/privacy/' | url }}">Privacy</a></li>
        <li><a href="{{ '/disclaimer/' | url }}">Disclaimer</a></li>
        <li><a href="{{ '/copyright/' | url }}">Copyright &amp; DMCA</a></li>
        <li><a href="{{ '/advertising/' | url }}">Advertising disclosure</a></li>
        <li><a href="{{ '/feed.xml' | url }}">RSS</a></li>
        <li><a href="{{ '/atom.xml' | url }}">Atom</a></li>
      </ul>
    </nav>
  </div>
</footer>
